executable = conda_wrapper_ocr.sh

LOGFILE = $(LOGFILE:ocr)

EXTRA_ARGS   = $(EXTRA_ARGS:)
# arguments    = python run_olmocr.py $(EXTRA_ARGS)

output     = logs/$(LOGFILE).out
error      = logs/$(LOGFILE).err
log        = logs/$(LOGFILE).log
getenv     = True

Requirements = CUDADriverVersion >= 12.0 && regexp("A100", TARGET.CUDADeviceName) 
+request_gpus = 2
queue