executable = conda_wrapper_eval.sh

LOGFILE = $(LOGFILE:eval_logic)
EXTRA_ARGS   = $(EXTRA_ARGS:)

arguments  = python eval_logic.py $(EXTRA_ARGS)

output     = logs_eval/$(LOGFILE).out
error      = logs_eval/$(LOGFILE).err
log        = logs_eval/$(LOGFILE).log
getenv     = True


# Depending on available nodes and model size, might need to add memory min, e.g., && (CUDAGlobalMemoryMb >= 20000)
Requirements = (CUDADriverVersion >= 12.0) && (CUDACapability >= 8) && (TotalSlotGPUs >= 1) 

+request_gpus = 1
queue
